{
  "name": "cakesplitter",
  "version": "0.5.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace @cakesplitter/web run build",
    "build:desktop": "npm --workspace @cakesplitter/desktop run build",
    "tauri": "npm --workspace @cakesplitter/desktop run tauri",
    "tauri:dev": "npm --workspace @cakesplitter/desktop run tauri:dev",
    "tauri:build": "npm --workspace @cakesplitter/desktop run tauri:build",
    "dev": "npm --workspace @cakesplitter/web run dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run packages apps",
    "test:desktop": "vitest run apps/desktop",
    "test:compatibility": "tsx tests/compatibility/run.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "validate:web": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
