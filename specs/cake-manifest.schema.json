{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakesplitter.dev/specs/cake-manifest.schema.json",
  "title": "Cake Manifest 1.0",
  "description": "Portable metadata for a CakeSplitter Cake Package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "packageId",
    "createdAt",
    "original",
    "targetSliceSize",
    "sliceCount",
    "slices"
  ],
  "properties": {
    "format": { "const": "cakesplitter" },
    "version": { "const": "1.0" },
    "packageId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "size", "sha256"],
      "properties": {
        "filename": { "$ref": "#/$defs/portableFilename" },
        "size": { "$ref": "#/$defs/safeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetSliceSize": {
      "allOf": [
        { "$ref": "#/$defs/safeInteger" },
        { "minimum": 1 }
      ]
    },
    "sliceCount": {
      "allOf": [
        { "$ref": "#/$defs/safeInteger" },
        { "maximum": 50000 }
      ]
    },
    "slices": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "filename", "offset", "size", "sha256"],
        "properties": {
          "index": {
            "allOf": [
              { "$ref": "#/$defs/safeInteger" },
              { "minimum": 1 }
            ]
          },
          "filename": { "$ref": "#/$defs/portableFilename" },
          "offset": { "$ref": "#/$defs/safeInteger" },
          "size": { "$ref": "#/$defs/safeInteger" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portableFilename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A single portable path component. Implementations additionally enforce a 200 UTF-8 byte limit and case-insensitive Windows reserved-name rejection.",
      "not": {
        "anyOf": [
          { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" },
          { "pattern": "[\\\\/:<>\"|?*\\u0000-\\u001f\\u007f-\\u009f]" },
          { "pattern": "^[.]?[.]?$" },
          { "pattern": "^[\\s]|[.\\s]$" },
          { "pattern": "^[cC][oO][nN](?:[.]|$)" },
          { "pattern": "^[pP][rR][nN](?:[.]|$)" },
          { "pattern": "^[aA][uU][xX](?:[.]|$)" },
          { "pattern": "^[nN][uU][lL](?:[.]|$)" },
          { "pattern": "^[cC][lL][oO][cC][kK]\\$(?:[.]|$)" },
          { "pattern": "^(?:[cC][oO][mM]|[lL][pP][tT])[1-9¹²³](?:[.]|$)" }
        ]
      }
    }
  }
}
