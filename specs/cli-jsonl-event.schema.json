{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakesplitter.local/specs/cli-jsonl-event.schema.json",
  "title": "CakeSplitter CLI JSONL event schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "event",
    "command",
    "operationId",
    "timestamp",
    "sequence",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "event": {
      "enum": [
        "started",
        "preflight",
        "progress",
        "warning",
        "paused",
        "resumed",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "command": {
      "enum": ["split", "merge", "inspect", "verify", "plan", "version", "help", "unknown"]
    },
    "operationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" }
  }
}
