{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakesplitter.local/specs/cli-jsonl-event.schema.json",
  "title": "CakeSplitter CLI JSONL event schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "event",
    "command",
    "timestamp",
    "sequence",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "event": {
      "enum": [
        "started",
        "preflight",
        "progress",
        "warning",
        "paused",
        "resumed",
        "completed",
        "failed",
        "cancelled",
        "batch-started",
        "batch-preflight",
        "operation-ready",
        "operation-started",
        "operation-progress",
        "operation-warning",
        "operation-completed",
        "operation-failed",
        "operation-blocked",
        "operation-cancelled",
        "batch-interrupted",
        "batch-completed",
        "batch-failed",
        "batch-cancelled"
      ]
    },
    "command": {
      "enum": ["split", "merge", "inspect", "verify", "plan", "batch", "version", "help", "unknown"]
    },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "batch" } } },
      "then": { "required": ["operationId", "runId"] }
    },
    {
      "if": { "properties": { "command": { "not": { "const": "batch" } } } },
      "then": { "required": ["operationId"], "not": { "required": ["runId"] } }
    },
    {
      "if": { "properties": { "event": { "enum": ["operation-ready", "operation-started", "operation-progress", "operation-warning", "operation-completed", "operation-failed", "operation-blocked", "operation-cancelled"] } } },
      "then": { "required": ["operationId", "runId"] }
    }
  ]
}
