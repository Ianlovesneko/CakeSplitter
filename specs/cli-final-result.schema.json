{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakesplitter.local/specs/cli-final-result.schema.json",
  "title": "CakeSplitter CLI final JSON result schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationVersion",
    "command",
    "status",
    "result",
    "warnings",
    "error",
    "startedAt",
    "completedAt",
    "durationMs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "applicationVersion": { "type": "string", "minLength": 1 },
    "command": {
      "enum": ["split", "merge", "inspect", "verify", "plan", "batch", "version", "help", "unknown"]
    },
    "status": {
      "enum": ["completed", "completed-with-failures", "failed", "cancelled", "interrupted", "not-ready"]
    },
    "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "error": {
      "oneOf": [
        { "$ref": "cli-error.schema.json" },
        { "type": "null" }
      ]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "runId": { "type": "string", "format": "uuid" },
    "jobName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "jobSpecDigest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "failurePolicy": { "enum": ["stop", "continue-independent"] },
    "operationCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000 }
    },
    "operations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status", "attemptCount", "result", "error"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "command": { "enum": ["split", "merge", "inspect", "verify"] },
          "status": { "enum": ["not-started", "running", "ready", "not-ready", "completed", "failed", "cancelled", "blocked", "interrupted"] },
          "attemptCount": { "type": "integer", "minimum": 0, "maximum": 8 },
          "result": { "type": ["object", "array", "string", "number", "boolean", "null"] },
          "error": {
            "oneOf": [
              { "$ref": "https://cakesplitter.local/specs/cli-error.schema.json" },
              { "type": "null" }
            ]
          },
          "dependsOn": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 128 },
          "order": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "ready": { "type": "boolean" },
          "plan": { "type": ["object", "array", "string", "number", "boolean", "null"] },
          "reason": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "command": { "const": "batch" } } },
      "then": { "required": ["runId"] }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "batch" },
          "status": { "enum": ["completed", "completed-with-failures", "interrupted", "not-ready"] }
        }
      },
      "then": {
        "required": ["jobName", "jobSpecDigest", "failurePolicy", "operationCounts", "operations"]
      }
    },
    {
      "if": { "properties": { "command": { "not": { "const": "batch" } }, "status": { "enum": ["failed", "cancelled"] } } },
      "then": { "required": ["error"], "properties": { "error": { "$ref": "https://cakesplitter.local/specs/cli-error.schema.json" } } }
    }
  ]
}
