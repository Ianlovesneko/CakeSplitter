{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakesplitter.local/specs/cli-error.schema.json",
  "title": "CakeSplitter CLI structured error schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "message",
    "technicalMessage",
    "retryable",
    "suggestedAction"
  ],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": {
      "enum": [
        "usage",
        "source",
        "destination",
        "package",
        "integrity",
        "permission",
        "storage",
        "conflict",
        "recovery",
        "capacity",
        "cancellation",
        "internal"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "technicalMessage": { "type": "string", "maxLength": 2000 },
    "retryable": { "type": "boolean" },
    "suggestedAction": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "operationId": { "type": "string", "format": "uuid" }
  }
}
